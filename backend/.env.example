# =====================================================================
# AIpt — environment template (reference only, do NOT commit real values)
# Copy to .env and fill in actual values for local dev or prod.
# =====================================================================

# === App ===
APP_NAME=AIpt RAG Platform
APP_ENV=dev                 # dev | prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_STORAGE_DIR=data/uploads

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aipt
POSTGRES_PASSWORD=aipt
POSTGRES_DB=aipt

# === JWT Auth — MUST change AUTH_JWT_SECRET in production ===
AUTH_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
AUTH_JWT_ALGO=HS256
AUTH_JWT_EXPIRE_MINUTES=720       # 12 hours

# === Redis (unused currently) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === LLM — unified OpenAI-compatible protocol (pick one) ===
# provider: deepseek | glm | qwen
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_FALLBACK_PROVIDER=qwen
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_MODEL=qwen-plus

# === Embedding ===
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# === RAG ===
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_VECTOR_TOP_K=10
RAG_BM25_TOP_K=10
RAG_FINAL_TOP_K=6
